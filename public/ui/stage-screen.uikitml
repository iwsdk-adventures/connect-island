<!--
  Content shown on the stage's curved screen. Wide slide format, read from the
  benches, so type is large and there are only three lines of it.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .slide {
    flex-direction: column;
    justify-content: space-between;
    font-family: "DM Sans";
    width: 900px;
    height: 500px;
    background-color: #0c1c4e;
    border-radius: 18px;
    border-width: 3px;
    border-color: #3f6ad0;
    padding-top: 44px;
    padding-bottom: 40px;
    padding-left: 52px;
    padding-right: 52px;
  }
  .top {
    flex-direction: column;
  }
  .eyebrow {
    font-size: 22px;
    font-weight: 700;
    color: #6fa4ff;
    letter-spacing: 3px;
  }
  .title {
    font-size: 74px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.06;
    margin-top: 18px;
  }
  .subtitle {
    font-size: 28px;
    font-weight: 400;
    color: #b9cdf0;
    line-height: 1.35;
    margin-top: 20px;
    width: 720px;
  }
  .footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
  }
  .stamp {
    font-size: 22px;
    font-weight: 500;
    color: #7f9fd8;
  }
</style>
<div class="slide">
  <div class="top">
    <div class="eyebrow">NOW ON STAGE</div>
    <div class="title">Your first WebXR scene</div>
    <div class="subtitle">
      From npm create to a headset in ten minutes, with the Immersive Web SDK.
    </div>
  </div>
  <div class="footer">
    <div class="brand">Meta Connect 2026</div>
    <div class="stamp">September 23-24</div>
  </div>
</div>
