<!--
  Pavilion info panel - site guide. Third reading station, facing the firepit.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .card {
    flex-direction: column;
    justify-content: space-between;
    font-family: "DM Sans";
    width: 420px;
    height: 500px;
    background-color: #0a1f4d;
    border-radius: 24px;
    border-width: 2px;
    border-color: #2c53ac;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 30px;
    padding-right: 30px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    color: #ffb27f;
    letter-spacing: 2px;
  }
  .title {
    font-size: 40px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.08;
    margin-top: 10px;
  }
  .body {
    font-size: 16px;
    font-weight: 400;
    color: #c3d5f4;
    line-height: 1.45;
    margin-top: 16px;
    width: 360px;
  }
  .row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 18px;
  }
  .marker {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: #1b3f96;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
  }
  .marker-text {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
  }
  .row-body {
    flex-direction: column;
    width: 312px;
  }
  .row-head {
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }
  .row-text {
    font-size: 15px;
    font-weight: 400;
    color: #b8cbec;
    line-height: 1.4;
    margin-top: 3px;
  }
  .footer {
    font-size: 14px;
    font-weight: 500;
    color: #86a6e0;
    margin-top: 24px;
  }
</style>
<div class="card">
  <div class="eyebrow">THE GROUNDS</div>
  <div class="title">Find your way</div>
  <div class="body">
    Three destinations, one at each corner. You are standing in the pavilion at
    the centre. Every path leads back here.
  </div>

  <div class="row">
    <div class="marker"><div class="marker-text">1</div></div>
    <div class="row-body">
      <div class="row-head">Entrance &amp; monument</div>
      <div class="row-text">
        The infinity mark on its plinth marks the way in.
      </div>
    </div>
  </div>

  <div class="row">
    <div class="marker"><div class="marker-text">2</div></div>
    <div class="row-body">
      <div class="row-head">Firepit lounge</div>
      <div class="row-text">
        Seating around an open fire. Best place to watch the light go.
      </div>
    </div>
  </div>

  <div class="row">
    <div class="marker"><div class="marker-text">3</div></div>
    <div class="row-body">
      <div class="row-head">Session stage</div>
      <div class="row-text">
        Short talks and demos under the lighting ring.
      </div>
    </div>
  </div>

  <div class="footer">Built with the Immersive Web SDK</div>
</div>
