<!--
  Pavilion info panel - Meta Connect 2026.
  Authored at 420 units wide; placed at scale 0.4 for a ~1.7 m reading panel.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .card {
    flex-direction: column;
    justify-content: space-between;
    font-family: "DM Sans";
    width: 420px;
    height: 500px;
    background-color: #0a1f4d;
    border-radius: 24px;
    border-width: 2px;
    border-color: #2c53ac;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 30px;
    padding-right: 30px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    color: #7fb0ff;
    letter-spacing: 2px;
  }
  .title {
    font-size: 42px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.08;
    margin-top: 10px;
  }
  .datebar {
    flex-direction: row;
    align-items: center;
    background-color: #1b3f96;
    border-radius: 15px;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 18px;
    padding-right: 18px;
    margin-top: 18px;
  }
  .datebar-text {
    font-size: 19px;
    font-weight: 700;
    color: #eaf1ff;
  }
  .body {
    font-size: 16px;
    font-weight: 400;
    color: #c3d5f4;
    line-height: 1.45;
    margin-top: 20px;
    width: 360px;
  }
  .row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 16px;
  }
  .bullet {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #4d8cff;
    margin-top: 6px;
    margin-right: 13px;
  }
  .row-body {
    flex-direction: column;
    width: 335px;
  }
  .row-head {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }
  .row-text {
    font-size: 15px;
    font-weight: 400;
    color: #b8cbec;
    line-height: 1.4;
    margin-top: 3px;
  }
  .footer {
    font-size: 14px;
    font-weight: 500;
    color: #86a6e0;
    margin-top: 24px;
  }
</style>
<div class="card">
  <div class="eyebrow">META CONNECT</div>
  <div class="title">Connect 2026</div>
  <div class="datebar">
    <div class="datebar-text">September 23-24, Menlo Park</div>
  </div>
  <div class="body">
    Meta's annual developer conference. Two days on AI, AI glasses and
    wearables, VR, and the metaverse.
  </div>

  <div class="row">
    <div class="bullet"></div>
    <div class="row-body">
      <div class="row-head">Day one: Keynote</div>
      <div class="row-text">
        Mark Zuckerberg on how Meta is building a future for everyone.
      </div>
    </div>
  </div>

  <div class="row">
    <div class="bullet"></div>
    <div class="row-body">
      <div class="row-head">Day two: Developer sessions</div>
      <div class="row-text">
        Teams across Meta on the breakthroughs developers can build on.
      </div>
    </div>
  </div>

  <div class="row">
    <div class="bullet"></div>
    <div class="row-body">
      <div class="row-head">Watch from anywhere</div>
      <div class="row-text">
        Free global livestream, register at meta.com/connect.
      </div>
    </div>
  </div>

  <div class="footer">meta.com/connect</div>
</div>
