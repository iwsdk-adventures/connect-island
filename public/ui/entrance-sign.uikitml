<!--
  Entrance signage, mounted between the gate pylons. Wide format, read at
  distance on approach, so type is large and the card is sparse.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .sign {
    flex-direction: column;
    align-items: center;
    font-family: "DM Sans";
    width: 700px;
    background-color: #081a44;
    border-radius: 30px;
    border-width: 3px;
    border-color: #3b63bd;
    padding-top: 34px;
    padding-bottom: 34px;
    padding-left: 40px;
    padding-right: 40px;
  }
  .title {
    font-size: 66px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.05;
    text-align: center;
  }
  .rule {
    width: 220px;
    height: 4px;
    border-radius: 2px;
    background-color: #4d8cff;
    margin-top: 20px;
  }
  .dates {
    font-size: 27px;
    font-weight: 700;
    color: #a8c6ff;
    margin-top: 20px;
    text-align: center;
  }
  .welcome {
    font-size: 19px;
    font-weight: 400;
    color: #93aeda;
    margin-top: 14px;
    text-align: center;
  }
</style>
<div class="sign">
  <div class="title">Meta Connect 2026</div>
  <div class="rule"></div>
  <div class="dates">September 23-24</div>
  <div class="welcome">Welcome to the grounds</div>
</div>
