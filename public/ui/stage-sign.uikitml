<!--
  Stage schedule board, mounted beside the riser. Session titles are this
  site's own illustrative programme, not Meta's published agenda.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .board {
    flex-direction: column;
    font-family: "DM Sans";
    width: 400px;
    background-color: #1a1038;
    border-radius: 22px;
    border-width: 2px;
    border-color: #6d4bc4;
    padding-top: 26px;
    padding-bottom: 26px;
    padding-left: 28px;
    padding-right: 28px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    color: #c9a6ff;
    letter-spacing: 2px;
  }
  .title {
    font-size: 34px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-top: 10px;
  }
  .slot {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 18px;
  }
  .time {
    font-size: 15px;
    font-weight: 700;
    color: #b98cff;
    width: 74px;
    margin-top: 2px;
  }
  .slot-body {
    flex-direction: column;
    width: 262px;
  }
  .slot-head {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }
  .slot-text {
    font-size: 14px;
    font-weight: 400;
    color: #b3a6d4;
    line-height: 1.4;
    margin-top: 2px;
  }
  .footer {
    font-size: 13px;
    font-weight: 500;
    color: #8f7fbb;
    margin-top: 24px;
  }
</style>
<div class="board">
  <div class="eyebrow">ON THIS STAGE</div>
  <div class="title">Short sessions</div>

  <div class="slot">
    <div class="time">10:00</div>
    <div class="slot-body">
      <div class="slot-head">Your first WebXR scene</div>
      <div class="slot-text">From npm create to a headset in ten minutes.</div>
    </div>
  </div>

  <div class="slot">
    <div class="time">11:30</div>
    <div class="slot-body">
      <div class="slot-head">Hands, rays and grabs</div>
      <div class="slot-text">Interaction patterns that feel right in VR.</div>
    </div>
  </div>

  <div class="slot">
    <div class="time">14:00</div>
    <div class="slot-body">
      <div class="slot-head">Physics without the pain</div>
      <div class="slot-text">Havok in a web worker, and when not to use it.</div>
    </div>
  </div>

  <div class="slot">
    <div class="time">15:30</div>
    <div class="slot-body">
      <div class="slot-head">Agents in the loop</div>
      <div class="slot-text">Letting an AI drive, test and debug your scene.</div>
    </div>
  </div>

  <div class="footer">Illustrative programme for this demo site</div>
</div>
